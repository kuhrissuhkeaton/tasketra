+.sync-ask-card.hot { border-top: 3px solid var(--red); }
+.sync-ask-card:hover .sync-ask-title { text-decoration: underline; text-underline-offset: 3px; }
+.sync-ask-title { display: block; font-weight: 600; font-size: 15px; }
+.sync-editors { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
+.sync-editor-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
+.sync-editor-title { margin: 0; font-size: 16px; }
+.sync-editor-hint { font-size: 11.5px; color: var(--slate-text); }
+.sync-editor-empty { margin: 4px 0; font-size: 13.5px; color: var(--slate-text); }
+.sync-bullets { list-style: none; margin: 0; padding: 0; }
+.sync-bullet { display: flex; align-items: flex-start; gap: 6px; padding: 3px 0; }
+.sync-bullet::before { content: "•"; flex: none; color: var(--slate-text); line-height: 1.5; }
+.sync-bullet-text { flex: 1; min-width: 0; padding: 2px 6px; margin: 0; border: none; border-radius: 6px; background: none; font: inherit; font-size: 14px; line-height: 1.5; text-align: left; color: var(--navy); cursor: text; overflow-wrap: break-word; }
+.sync-bullet-text:hover { background: var(--tint); }
+.sync-bullet-input { flex: 1; min-width: 0; padding: 3px 8px; border: 1px solid var(--slate); border-radius: 8px; font: inherit; font-size: 14px; line-height: 1.5; color: var(--navy); background: var(--panel); }
+.sync-bullet-remove { flex: none; width: 22px; height: 22px; margin-top: 2px; padding: 0; border: none; border-radius: 50%; background: none; font-size: 15px; line-height: 1; color: var(--slate-text); cursor: pointer; }
+.sync-bullet-remove:hover { color: var(--red); background: var(--surface-muted); }
+.sync-add-line { margin-top: 8px; padding: 2px 6px; border: none; background: none; font: inherit; font-size: 13.5px; font-weight: 600; color: var(--slate-text); cursor: pointer; }
+.sync-add-line:hover { color: var(--navy); }
+.sync-recap-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
+.sync-recap-name { display: block; font-family: 'Fraunces', serif; font-size: 17px; font-weight: 700; color: var(--navy); }
+.sync-recap-meta { display: block; margin-top: 2px; font-size: 13px; color: var(--slate-text); }
+.sync-recap-block { margin-top: 14px; }
+.sync-recap-h { margin: 0 0 4px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--slate-text); }
+.sync-recap-p { margin: 0; font-size: 14px; line-height: 1.55; }
+.sync-recap-list { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.55; }
+.sync-recap-list li { margin: 3px 0; }
+.sync-recap-clean { margin-top: 14px; }
+@media (max-width: 900px) { .sync-editors { grid-template-columns: 1fr; } }
+@media (max-width: 760px) { .sync-ask-grid { grid-template-columns: 1fr; } }
 
