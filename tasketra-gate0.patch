+          `A restore only ever runs into an empty database.`
+      );
+      process.exit(2);
+    }
+
+    // ---- Schema: every migration, in order --------------------------------
+    t0 = Date.now();
+    const migrationDirs = readdirSync(MIGRATIONS_DIR, { withFileTypes: true })
+      .filter((d) => d.isDirectory())
+      .map((d) => d.name)
+      .sort();
