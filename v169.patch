+    expect((await apiTokens(asUser(user, { method: "POST", url: U, body: { name: "X", scope: "admin" } }))).status).toBe(400);
+    expect((await apiTokens(asUser(user, { method: "POST", url: U, body: { name: "X", scope: "write" } }))).status).toBe(201);
