@@ -0,0 +1,158 @@
+import { describe, it, expect, beforeAll, afterAll, beforeEach, afterEach } from "vitest";
+import { setupTestDb, teardownTestDb, resetTestDb } from "../../lib/__tests__/testDb.ts";
+import { createTestUser, createTestProject, createTestDocument, asUser, jsonBody, rawQuery } from "./fixtures.ts";
+import handler from "../admin-project-view.mts";
+import { db } from "../../lib/db.ts";
+
+// Admin support view (v149): strict-admin, GET-only, read-only look at a
+// user's projects, with an audit row per snapshot/download.
+
+const URL = "https://app.tasketra.com/api/admin-project-view";
+const ADMIN = "admin@example.com";
+
+async function setup() {
+  process.env.ADMIN_EMAIL = ADMIN;
+  const admin = await createTestUser(ADMIN, { foundingMember: true });
+  return { admin };
+}
+
+const get = (user: { cookie: string }, query = "") => handler(asUser(user, { method: "GET", url: URL + query }));
+
+async function auditCount(projectId: string): Promise<number> {
+  const { rows } = await rawQuery(`SELECT count(*)::int AS count FROM admin_project_views WHERE project_id = '${projectId}'`);
+  return rows[0].count;
+}
+
+describe("admin-project-view", () => {
+  beforeAll(async () => {
+    await setupTestDb();
+  }, 30000);
+  afterAll(async () => {
+    await teardownTestDb();
+  });
+  beforeEach(async () => {
+    await resetTestDb();
+    delete process.env.ADMIN_EMAIL;
+  });
+  afterEach(() => {
+    delete process.env.ADMIN_EMAIL;
+  });
+
+  describe("who may use it", () => {
+    it("rejects an unauthenticated request", async () => {
+      expect((await handler(new Request(URL))).status).toBe(401);
+    });
+
+    it("fails closed when ADMIN_EMAIL is not set", async () => {
+      const someone = await createTestUser("someone@example.com", { foundingMember: true });
+      expect((await get(someone, `?userId=${someone.id}`)).status).toBe(403);
+    });
+
+    it("rejects a signed-in user who is not the admin", async () => {
+      await setup();
+      const other = await createTestUser("other@example.com");
+      expect((await get(other, `?userId=${other.id}`)).status).toBe(403);
+    });
+
+    it("rejects writes: every non-GET method is a 405, even for the admin", async () => {
+      const { admin } = await setup();
+      for (const method of ["POST", "PUT", "PATCH", "DELETE"]) {
+        expect((await handler(asUser(admin, { method, url: URL, body: {} }))).status).toBe(405);
+      }
+    });
+
+    it("requires a userId or projectId", async () => {
+      const { admin } = await setup();
+      expect((await get(admin)).status).toBe(400);
+    });
+  });
+
+  describe("project list", () => {
+    it("lists the target user's owned projects with counts", async () => {
+      const { admin } = await setup();
+      const owner = await createTestUser("owner@example.com");
+      const p = await createTestProject(owner.id, "Kitchen Reno");
+      await createTestProject(owner.id, "Second");
+      await createTestProject(admin.id, "Admin's own — must not appear");
+      const database = db();
+      await database.sql`INSERT INTO tasks (project_id, title, status) VALUES (${p.id}, 'Hang cabinets', 'in_progress')`;
+      await database.sql`INSERT INTO decision_requests (project_id, title, status, options, public_token) VALUES (${p.id}, 'Countertop material', 'open', '["Wood", "Stone"]'::jsonb, 'tok-list')`;
+      await createTestDocument(p.id, owner.id, 2048);
+
+      const body = await jsonBody<{ owner: any; projects: any[] }>(await get(admin, `?userId=${owner.id}`));
+      expect(body.owner.email).toBe("owner@example.com");
+      expect(body.projects.map((x) => x.name).sort()).toEqual(["Kitchen Reno", "Second"]);
+      expect(body.projects.find((x) => x.name === "Kitchen Reno")).toMatchObject({ task_count: 1, open_decisions: 1, document_count: 1 });
+    });
+
+    it("404s for an unknown user", async () => {
+      const { admin } = await setup();
+      expect((await get(admin, `?userId=${crypto.randomUUID()}`)).status).toBe(404);
+    });
+  });
+
+  describe("snapshot", () => {
+    it("returns the project's contents and writes one audit row", async () => {
+      const { admin } = await setup();
+      const owner = await createTestUser("owner@example.com");
+      const p = await createTestProject(owner.id, "Marcus-Style Project");
+      const database = db();
+      await database.sql`INSERT INTO tasks (project_id, title, status, owner_name) VALUES (${p.id}, 'Only task', 'not_started', 'Sam')`;
+      await database.sql`INSERT INTO decision_requests (project_id, title, status, options, public_token) VALUES (${p.id}, 'Pick a date', 'open', '["Fri", "Sat"]'::jsonb, 'secret-token')`;
+      await database.sql`INSERT INTO risks (project_id, title, status, probability, impact) VALUES (${p.id}, 'Permit delay', 'open', 'high', 'medium')`;
+      await database.sql`INSERT INTO status_updates (project_id, body, health) VALUES (${p.id}, 'Kicked off', 'on_track')`;
+      await createTestDocument(p.id, owner.id, 1024, { filename: "plan.pdf" });
+
+      const res = await get(admin, `?projectId=${p.id}`);
+      expect(res.status).toBe(200);
+      const body = await jsonBody<any>(res);
+      expect(body.readOnly).toBe(true);
+      expect(body.project).toMatchObject({ name: "Marcus-Style Project", owner_email: "owner@example.com" });
+      expect(body.project.roadmap_share_token).toBeUndefined();
+      expect(body.tasks.map((t: any) => t.title)).toEqual(["Only task"]);
+      expect(body.decisions[0]).toMatchObject({ title: "Pick a date", status: "open" });
+      expect(body.decisions[0].public_token).toBeUndefined();
+      expect(body.risks.map((r: any) => r.title)).toEqual(["Permit delay"]);
+      expect(body.statusUpdates[0]).toMatchObject({ body: "Kicked off", health: "on_track" });
+      expect(body.documents.map((d: any) => d.filename)).toEqual(["plan.pdf"]);
+      expect(await auditCount(p.id)).toBe(1);
+    });
+
+    it("shows an empty project as empty (the support case this exists for)", async () => {
+      const { admin } = await setup();
+      const owner = await createTestUser("owner@example.com");
+      const p = await createTestProject(owner.id, "Empty Project");
+      const body = await jsonBody<any>(await get(admin, `?projectId=${p.id}`));
+      expect(body.tasks).toEqual([]);
+      expect(body.decisions).toEqual([]);
+      expect(body.documents).toEqual([]);
+      expect(body.activity).toEqual([]);
+    });
+
+    it("404s for an unknown project", async () => {
+      const { admin } = await setup();
+      expect((await get(admin, `?projectId=${crypto.randomUUID()}`)).status).toBe(404);
+    });
+  });
+
+  describe("document download", () => {
+    it("404s when the document belongs to a different project", async () => {
+      const { admin } = await setup();
+      const owner = await createTestUser("owner@example.com");
+      const p1 = await createTestProject(owner.id, "One");
+      const p2 = await createTestProject(owner.id, "Two");
+      const doc = await createTestDocument(p2.id, owner.id, 100);
+      expect((await get(admin, `?projectId=${p1.id}&documentId=${doc.id}`)).status).toBe(404);
+    });
+
+    it("reaches the blob lookup for an in-project document (404 only because the fixture writes no blob)", async () => {
+      const { admin } = await setup();
+      const owner = await createTestUser("owner@example.com");
+      const p = await createTestProject(owner.id, "Docs");
+      const doc = await createTestDocument(p.id, owner.id, 100);
+      const res = await get(admin, `?projectId=${p.id}&documentId=${doc.id}`);
+      expect(res.status).toBe(404);
+      expect((await jsonBody<any>(res)).error).toBe("File data missing");
+    });
+  });
+});
