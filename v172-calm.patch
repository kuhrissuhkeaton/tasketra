+  font-weight: 600;
+}
+.layer-group-body { padding: 0 var(--pad-card) var(--pad-card); }
+
+.layer-how { margin: 4px 0 14px; }
+.layer-how-btn {
+  background: none;
+  border: 0;
+  padding: 0;
+  font: inherit;
+  font-size: 13.5px;
