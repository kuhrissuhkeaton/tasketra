+    expect(host?.textContent).toContain("Needs attention");
+  });
+
+  it("collapses a layer group and remembers it", () => {
+    render(
+      <LayerGroup id="test-group" title="Medium" count={11}>
+        <p>group body</p>
+      </LayerGroup>,
+    );
