+  --gap-stack: 22px;
+}
+[data-density="compact"] {
+  --pad-card: 12px;
+  --pad-row: 7px;
+  --gap-stack: 12px;
+}
+[data-density="compact"] .table td,
+[data-density="compact"] .table th {
+  padding-top: 6px;
+  padding-bottom: 6px;
+}
+[data-density="compact"] .card {
+  padding: var(--pad-card);
+}
+
+.layer-stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
+  gap: 14px;
+  margin-bottom: var(--gap-stack);
+}
+.layer-stat {
+  background: var(--panel);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: var(--pad-card);
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  text-align: left;
+}
+.layer-stat-btn { cursor: pointer; font: inherit; }
+.layer-stat-btn:hover { border-color: var(--slate-2); }
+.layer-stat-label {
+  font-size: 12px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--slate-text);
+}
+.layer-stat-value { font-size: 26px; font-weight: 650; color: var(--navy); line-height: 1.15; }
+.layer-stat-sub { font-size: 13px; color: var(--slate-text); }
+.layer-stat-warn .layer-stat-value { color: #8a6d1c; }
+.layer-stat-bad .layer-stat-value { color: var(--red); }
+.layer-stat-ok .layer-stat-value { color: var(--success); }
+
+.layer-group {
+  background: var(--panel);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  margin-bottom: 14px;
+  overflow: hidden;
+}
+.layer-group-head { margin: 0; }
+.layer-group-btn {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  background: none;
+  border: 0;
+  padding: 14px var(--pad-card);
+  font: inherit;
+  font-weight: 600;
+  color: var(--navy);
+  cursor: pointer;
+  text-align: left;
+}
+.layer-group-chev { transition: transform 0.15s ease; color: var(--slate-text); font-size: 12px; }
+.layer-group-chev.is-open { transform: rotate(90deg); }
+.layer-group-count {
+  background: var(--surface-muted);
+  color: var(--slate-text);
