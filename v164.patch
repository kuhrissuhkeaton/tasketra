@@ -0,0 +1,56 @@
+// Donut (v164, dashboard plan Phase 7 -- shared visual kit). Segments use
+// the categorical palette (palette.ts), never status colors: a slice is a
+// category, not a verdict. The legend under the ring lists every segment
+// with its real count and its percent WITH words ("3 of 8 · 38%") -- the
+// kit's every-percent-carries-words rule. Callers put the table of real
+// items the plan asks for underneath the Donut themselves (it belongs to
+// the surface, not the chart). Kit rule: no chart from no data -- when
+// every segment is 0 the caller renders one sentence plus the creating
+// action instead of this component.
+export type DonutSegment = { label: string; value: number };
+
+export function Donut({ segments, colors, centerValue, centerLabel, ariaLabel }: {
+  segments: DonutSegment[];
+  /** Categorical color per segment, same order. */
+  colors: string[];
+  centerValue: string;
+  centerLabel: string;
+  ariaLabel: string;
+}) {
+  const total = segments.reduce((s, x) => s + x.value, 0);
+  let acc = 0;
+  const stops: string[] = [];
+  segments.forEach((s, i) => {
+    if (s.value <= 0 || total <= 0) return;
+    const from = (acc / total) * 360;
+    acc += s.value;
+    const to = (acc / total) * 360;
+    stops.push(`${colors[i]} ${from}deg ${to}deg`);
+  });
+  return (
+    <div className="kit-donut-wrap">
+      <div
+        className="kit-donut"
+        role="img"
+        aria-label={ariaLabel}
+        style={{ background: stops.length ? `conic-gradient(${stops.join(", ")})` : "var(--border)" }}
+      >
+        <div className="kit-donut-hole">
+          <div className="kit-donut-value">{centerValue}</div>
+          <div className="kit-donut-label">{centerLabel}</div>
+        </div>
+      </div>
+      <ul className="kit-donut-legend">
+        {segments.map((s, i) => (
+          <li key={s.label}>
+            <span className="kit-donut-swatch" style={{ background: colors[i] }} aria-hidden="true" />
+            <span className="kit-donut-legend-label">{s.label}</span>
+            <span className="kit-donut-legend-count">
+              {total > 0 ? `${s.value} of ${total} · ${Math.round((s.value / total) * 100)}%` : "0"}
+            </span>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
diff --git a/src/components/charts/Gauge.tsx b/src/components/charts/Gauge.tsx
new file mode 100644
index 0000000..6d22975
--- /dev/null
+++ b/src/components/charts/Gauge.tsx
@@ -0,0 +1,50 @@
+// Gauge (v164, dashboard plan Phase 7 -- shared visual kit, built once for
+// the v164/v165/v166 dashboard phases). A semicircle arc in a status
+// color, a plain-word label, a big number, and the "x of y" words under
+// it. Kit rules, binding on every surface that uses this:
+//   - every percent carries words: the caller passes `words` ("5 of 12
+//     tasks done") and the gauge never shows a bare number without them;
+//   - no chart from no data: when there is nothing to measure, the caller
+//     renders one sentence plus the action that creates the data instead
+//     of a gauge -- this component only draws a real measurement.
+export type GaugeTone = "good" | "warn" | "crit" | "brand";
+
+const TONE_COLOR: Record<GaugeTone, string> = {
+  good: "var(--chart-good)",
+  warn: "var(--chart-warn)",
+  crit: "var(--chart-crit)",
+  // The neutral portfolio tone: the Tasketra ink, for a measurement that
+  // is neither good nor bad on its own (completion, time used).
+  brand: "var(--ink)",
+};
+
+export function Gauge({ label, percent, tone, value, words }: {
+  /** Plain-word label, e.g. "Portfolio completion". */
+  label: string;
+  /** 0-100 (values past 100 clamp the arc but not the number). */
+  percent: number;
+  tone: GaugeTone;
+  /** The big number as displayed, e.g. "42%". */
+  value: string;
+  /** The "x of y" words under the number, e.g. "5 of 12 tasks done". */
+  words: string;
+}) {
+  const clamped = Math.max(0, Math.min(100, percent));
+  // Semicircle from (10, 62) to (110, 62), radius 50. pathLength=100 makes
+  // the dash math read as a plain percent of the arc.
+  const arc = "M 10 62 A 50 50 0 0 1 110 62";
+  return (
+    <div className="kit-gauge" role="img" aria-label={`${label}: ${value}, ${words}`}>
+      <div className="kit-gauge-label">{label}</div>
+      <svg viewBox="0 0 120 68" className="kit-gauge-svg" aria-hidden="true">
+        <path d={arc} fill="none" stroke="var(--border)" strokeWidth="10" strokeLinecap="round" />
+        {clamped > 0 && (
+          <path d={arc} fill="none" stroke={TONE_COLOR[tone]} strokeWidth="10" strokeLinecap="round"
+            pathLength={100} strokeDasharray={`${clamped} 100`} />
+        )}
+      </svg>
+      <div className="kit-gauge-value">{value}</div>
+      <div className="kit-gauge-words">{words}</div>
+    </div>
+  );
+}
